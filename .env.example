# Public site URL used for canonical links, sitemap, and Open Graph.
# Baked in at build time — set this before `npm run build`.
NEXT_PUBLIC_SITE_URL=https://www.axismetals.ca

# Contact form — Formspree form ID (recipient should be info@axismetals.ca).
# Create the form at https://formspree.io then paste the ID here before building.
NEXT_PUBLIC_FORMSPREE_FORM_ID=
